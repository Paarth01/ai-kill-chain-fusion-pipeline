# Fusion tuning
FUSION_DISTANCE_THRESHOLD_KM=1.5
FUSION_TIME_WINDOW_SECONDS=30
TRACK_STALE_AFTER_SECONDS=120

# Feed simulation rates (seconds between synthetic readings)
VEHICLE_IR_INTERVAL=2
UAV_UAS_INTERVAL=3
ELINT_INTERVAL=4
LEGACY_C2_INTERVAL=5

# Real YOLOv8n detection for the vehicle/IR feed.
# Requires: pip install -r requirements-detection.txt
ENABLE_REAL_DETECTION=false

# Path to model weights. Defaults to stock yolov8n.pt (auto-downloaded on
# first use). Point this at your own trained weights (e.g. from the
# Purplle Tech Challenge project) to use them instead — no code change
# needed.
YOLO_MODEL_PATH=yolov8n.pt

# Frame source: "demo" (bundled sample images), "webcam" (local webcam via
# OpenCV), or a path to a video file or image.
YOLO_FRAME_SOURCE=demo

# Distributed mode: point feeds/fusion at a shared Redis list instead of
# an in-process queue. Leave unset to run everything in one process.
# REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_KEY=sentinel:readings

# API key required on mutating endpoints (ack/assess/EW toggle) via an
# X-API-Key header. Leave unset for local dev (auth disabled). Set this
# before any real deployment — and set VITE_API_KEY to match on the
# frontend (frontend/.env.example).
# API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
