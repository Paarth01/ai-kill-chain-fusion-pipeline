# Leave unset for local dev — Vite's proxy (see vite.config.ts) forwards
# /tracks, /history, /stream, /ew, /health to http://localhost:8000.
#
# In production (frontend and backend on separate origins, e.g. Vercel +
# Render), set this to your deployed backend's URL:
# VITE_API_BASE_URL=https://your-backend.onrender.com

# Only needed if the backend has API_KEY set (see backend .env.example).
# Sent as X-API-Key on ack/assess/EW-toggle requests only.
# VITE_API_KEY=
